{
  "spec": "hongloumeng-c/aliases/0.1",
  "title": "实体归一表 —— 三张判据表共用的唯一一份",
  "doctrine": [
    "一份，不是三份。判词表、脂批表、事实表各带一份别名表，三份必然漂移——",
    "那正是本仓反复记录的『各部件各写各的』（RFC-0006 §0）。",
    "每条别名要么由写死的机械规则导出（rule），要么有原文佐证（quote），",
    "要么由两条以上原文推得并显式标记（inference）。没有一条可以靠『我觉得是同一个人』。",
    "歧义形（同一个称呼指向不同的人）单列并禁止用作实体名——把它归到任何一边都是错的。"
  ],
  "corpus": {
    "path": "demo/hongloumeng-c/corpus/wikisource-honglou-120.txt",
    "sha256": "1e9bee4d044e14be689152b0400d88dde2a55ae83570adffa928a865ab7995bd",
    "note": "2026-08-10 重建：第一版用 {{...}} 通配删模板，把 {{center|回目}} 连内容一起删掉了，120 条回目全部丢失，导致脂批表 B-05-2（佚回回目）无法验证。已修为先展开 center 再删其余模板。"
  },
  "rules": {
    "surname_prefix": {
      "how": "变体是规范名去掉姓氏前缀后的剩余部分，且被去掉的前缀属于声明的姓氏集",
      "surnames": [
        "賈",
        "林",
        "薛",
        "史",
        "王",
        "花",
        "秦",
        "衛",
        "李",
        "甄"
      ],
      "why": "红楼梦行文大量用「寶玉」「黛玉」「探春」指称，与全名同指，这是排印惯例不是别名问题，可机械判定，不需引文"
    }
  },
  "evidence_kinds": {
    "rule": "由 rules 里写死的机械规则导出，程序可复核，不需引文",
    "quote": "原文里有一句把两个名字直接等同起来，引文逐字可核",
    "inference": "原文没有直接等式，但两条以上引文合起来指向同一人。必须显式标记，且证据强度低于 quote"
  },
  "traps_recorded": [
    {
      "trap": "同字不同人",
      "case": "第五回警幻之妹『乳名兼美字可卿者』与秦可卿同字，是作者有意为之的重影，绝非同一人。若按『可卿』二字归一，会把一个仙姬并进秦可卿。",
      "why_it_matters": "与 zhipi-spec 里记的『懸崖撒手在第一回是评甄士隐』同类：字面相同、语境完全不同。"
    },
    {
      "trap": "歧义形",
      "case": "『王氏』在第二回指賈政之妻（王夫人），在第四回指薛蟠寡母（薛姨媽）——同一个称呼，两个人。",
      "why_it_matters": "归到任何一边都会造出错误的亲属边，且不会报错。故列入 ambiguous_forms 禁用。"
    },
    {
      "trap": "归一表漏掉最高频称呼",
      "case": "「鳳姐」出现于 102 回，「王熙鳳」只出现于 12 回，而归一表原先只登记了全名。判分器凡以王熙鳳为主语的谓词，实际只覆盖了全书不到一成的相关文本。",
      "why_it_matters": "这类漏不会报错，只会让谓词静默少召回，进而把「未交代」判得比实际多。是被 C0.6 的召回对照 A-12-4 漏报才暴露的。"
    },
    {
      "trap": "关键情节处改用称谓",
      "case": "迎春之死写在第一〇九回，而该处称她「二姑奶奶」而非「迎春」；判分器以「賈迎春／迎春」为锚点，整句漏掉。",
      "why_it_matters": "与「鳳姐」缺口同构，且更隐蔽——它只在一处关键情节上失效，日常回目里锚点都对得上，体检看不出来。由外部对抗性复核发现。"
    }
  ],
